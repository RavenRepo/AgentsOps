# Goku Agent System - Environment Configuration
# Copy this to .env and fill in your API keys
# DO NOT COMMIT .env to version control

# LLM Provider: NVIDIA (free trial)
NVIDIA_API_KEY=your_nvidia_api_key_here

# LLM Provider: OpenCode (free options available)
OPENCODE_API_KEY=your_opencode_api_key_here

# LLM Provider: OpenRouter (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hermes Configuration
HERMES_DEFAULT_MODEL=nvidia/meta/llama-3.1-8b-instruct
HERMES_MODEL_WALKS=nvidia/meta/llama-3.1-8b-instruct
HERMES_MODEL_RESEARCH=nvidia/meta/llama-3.1-8b-instruct
HERMES_MODEL_SYNTHESIS=opencode-go/qwen3.6-plus
HERMES_MODEL_REVIEW=nvidia/meta/llama-3.1-8b-instruct

# Coder Configuration
CODER_DEFAULT_MODEL=opencode-go/qwen3.6-plus

# Research Agent: RSS Feeds (optional)
RSS_FEED_URLS=https://example.com/feed.xml

# Research Agent: GitHub API (optional)
GITHUB_TOKEN=your_github_token_here

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# General Settings
LOG_LEVEL=INFO
DEBUG=false
