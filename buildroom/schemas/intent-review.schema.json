{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildroom.local/schemas/intent-review.schema.json",
  "title": "Intent review",
  "description": "Early filter that determines whether an idea contract is ready for Main review.",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "contract_id",
    "reviewed_by",
    "reviewed_at",
    "decision",
    "reasoning"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "_common.schema.json#/$defs/schema-version" },
    "review_id": { "$ref": "_common.schema.json#/$defs/slug" },
    "contract_id": { "$ref": "_common.schema.json#/$defs/slug" },
    "reviewed_by": { "$ref": "_common.schema.json#/$defs/agent-id" },
    "reviewed_at": { "$ref": "_common.schema.json#/$defs/timestamp" },
    "decision": {
      "type": "string",
      "enum": ["pass", "fail", "needs_revision", "experiment_only"]
    },
    "reasoning": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "gaps_identified": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap", "severity"],
        "additionalProperties": false,
        "properties": {
          "gap": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["minor", "moderate", "blocking"]
          },
          "suggested_fix": { "type": "string" }
        }
      }
    },
    "signal_check": {
      "type": "object",
      "description": "Verification of signal-filter thresholds",
      "additionalProperties": false,
      "properties": {
        "score_threshold_met": { "type": "boolean" },
        "min_walks_met": { "type": "boolean" },
        "min_signal_types_met": { "type": "boolean" },
        "no_active_lock": { "type": "boolean" },
        "no_cooldown": { "type": "boolean" }
      }
    },
    "auto_decision": {
      "type": "boolean",
      "default": false,
      "description": "Whether this review was auto-generated by signal-filter rules"
    }
  }
}
