{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Input",
  "description": "Output from research/discovery phase",
  "type": "object",
  "required": ["id", "topic", "findings", "timestamp"],
  "properties": {
    "id": {"type": "string"},
    "topic": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {"type": "object"}
    },
    "context": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
